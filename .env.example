# Optional — without a key, the app uses a fake-mode keyword router.
# Get a key at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_key_here

# Optional — for the "forward report to accountant" demo to actually email.
# Get a key at https://resend.com/api-keys (free tier is plenty)
RESEND_API_KEY=

# Optional — when set, every email is redirected here instead of the
# original recipient. Useful for the demo so you can see the email arrive.
FORWARD_TO=jetonkorenica@gmail.com
